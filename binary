import java.util.*;
class Solution
{
    public static void main(String[] args)
    {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int count = 0,r,max=0;
        while(n>0)
        {
            r = n%2;
            n=n/2;
            if(r==1)
            {
                count++;
                if(count>max)
                {
                    max = count;
                }
            }
            else
            {
                count =0;
            }
        }
        System.out.println(max);
    }
}
